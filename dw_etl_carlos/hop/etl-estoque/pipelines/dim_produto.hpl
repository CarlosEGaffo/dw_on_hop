      </value>
      <value>
        <name>categoria</name>
        <rename>categoria</rename>
        <update>Y</update>
      </value>
      <value>
        <name>categoria_pai</name>
        <rename>categoria_pai</rename>
        <update>Y</update>
      </value>
      <value>
        <name>unidade_sigla</name>
        <rename>unidade_sigla</rename>
        <update>Y</update>
      </value>
      <value>
        <name>unidade_descricao</name>
