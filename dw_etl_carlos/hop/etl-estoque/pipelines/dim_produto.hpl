      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Carregar dim_produto</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DW-DESTINO</connection>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>dw</schema>
      <table>dim_produto</table>
      <key>
        <name>sku</name>
        <field>sku</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>sku</name>
        <rename>sku</rename>
        <update>N</update>
      </value>
      <value>
        <name>nk_produto</name>
        <rename>nk_produto</rename>
        <update>Y</update>
      </value>
      <value>
        <name>nome_produto</name>
        <rename>nome_produto</rename>
        <update>Y</update>
      </value>
      <value>
        <name>marca</name>
        <rename>marca</rename>
