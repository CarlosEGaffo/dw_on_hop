<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_produto</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Extrai produtos do ERP, padroniza SKU/nomes, remove duplicados e carrega dw.dim_produto</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>Carlos Eduardo Gaffo da Rocha</created_user>
    <created_date>2026/11/09 12:00:00.000</created_date>
    <modified_user>Carlos Eduardo Gaffo da Rocha</modified_user>
    <modified_date>2026/11/09 12:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>dim_produto: SKU em maiúsculo e sem espaços. Os produtos 34, 35 e 36 (inf-007, esc-016, inf-009) são cópias dos 7, 16 e 9 e são descartados pelo Unique rows (fica o primeiro id). Chave = sku.</note>
      <xloc>48</xloc>
      <yloc>16</yloc>
      <width>900</width>
      <heigth>60</heigth>
      <fontname/>
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Produtos ERP</from>
      <to>Padronizar textos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Padronizar textos</from>
      <to>Marca nula</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Marca nula</from>
      <to>Remover produtos duplicados</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remover produtos duplicados</from>
      <to>Carregar dim_produto</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Produtos ERP</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ERP-ORIGEM</connection>
    <sql>SELECT p.id_produto        AS nk_produto,
       p.sku,
       p.nome              AS nome_produto,
       p.marca,
       c.nome              AS categoria,
       COALESCE(cp.nome, c.nome) AS categoria_pai,
       u.sigla             AS unidade_sigla,
       u.descricao         AS unidade_descricao,
       p.custo_padrao,
       p.preco_venda,
       p.ativo
FROM erp.produto p
JOIN erp.categoria_produto c       ON c.id_categoria = p.id_categoria
LEFT JOIN erp.categoria_produto cp ON cp.id_categoria = c.id_categoria_pai
JOIN erp.unidade_medida u          ON u.id_unidade = p.id_unidade
ORDER BY p.id_produto</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Padronizar textos</name>
    <type>StringOperations</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
