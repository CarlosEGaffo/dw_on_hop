<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_lote</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Lotes do ERP com o SKU padronizado do produto</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>Carlos Eduardo Gaffo da Rocha</created_user>
    <created_date>2026/11/09 12:00:00.000</created_date>
    <modified_user>Carlos Eduardo Gaffo da Rocha</modified_user>
    <modified_date>2026/11/09 12:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>dim_lote: o SKU padronizado liga o lote ao produto correto mesmo quando o lote foi cadastrado num produto duplicado (ex.: produto 36 inf-009 -&gt; INF-009).</note>
      <xloc>48</xloc>
      <yloc>16</yloc>
      <width>900</width>
      <heigth>60</heigth>
      <fontname/>
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Lotes ERP</from>
      <to>Padronizar textos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Padronizar textos</from>
      <to>Carregar dim_lote</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Lotes ERP</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ERP-ORIGEM</connection>
    <sql>SELECT l.id_lote AS nk_lote,
       l.numero_lote,
       p.sku    AS sku_produto,
       l.data_fabricacao,
       l.data_validade
FROM erp.lote_produto l
JOIN erp.produto p ON p.id_produto = l.id_produto
ORDER BY l.id_lote</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Padronizar textos</name>
    <type>StringOperations</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>numero_lote</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>sku_produto</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Carregar dim_lote</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DW-DESTINO</connection>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>dw</schema>
      <table>dim_lote</table>
      <key>
        <name>nk_lote</name>
        <field>nk_lote</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>nk_lote</name>
        <rename>nk_lote</rename>
        <update>N</update>
      </value>
      <value>
        <name>numero_lote</name>
        <rename>numero_lote</rename>
        <update>Y</update>
      </value>
      <value>
        <name>sku_produto</name>
        <rename>sku_produto</rename>
        <update>Y</update>
      </value>
      <value>
        <name>data_fabricacao</name>
        <rename>data_fabricacao</rename>
        <update>Y</update>
      </value>
      <value>
        <name>data_validade</name>
        <rename>data_validade</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
