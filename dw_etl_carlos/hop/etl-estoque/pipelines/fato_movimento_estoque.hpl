  <transform>
    <name>Movimentações ERP</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ERP-ORIGEM</connection>
    <sql>SELECT m.id_movimento,
       m.data_movimento,
       CAST(TO_CHAR(m.data_movimento, 'YYYYMMDD') AS INTEGER) AS nk_data,
       p.sku,
       m.id_lote,
       m.id_deposito,
       m.tipo_movimento,
       m.quantidade,
       p.custo_padrao,
       m.id_pedido_venda,
       m.id_pedido_compra,
       COALESCE(pv.status, pc.status) AS status_documento,
       m.observacao
FROM erp.movimento_estoque m
JOIN erp.produto p            ON p.id_produto = m.id_produto
LEFT JOIN erp.pedido_venda pv  ON pv.id_pedido = m.id_pedido_venda
LEFT JOIN erp.pedido_compra pc ON pc.id_pedido_compra = m.id_pedido_compra
ORDER BY m.id_movimento</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
