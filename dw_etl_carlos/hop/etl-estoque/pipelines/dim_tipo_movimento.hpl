<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_tipo_movimento</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Padroniza as 8 grafias de tipo_movimento em ENTRADA / SAIDA / AJUSTE</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>Carlos Eduardo Gaffo da Rocha</created_user>
    <created_date>2026/11/09 12:00:00.000</created_date>
    <modified_user>Carlos Eduardo Gaffo da Rocha</modified_user>
    <modified_date>2026/11/09 12:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>dim_tipo_movimento: ENTRADA/Entrada/entrada, SAIDA/SAÍDA/Saída/saida e AJUSTE viram 3 códigos. fator_sinal: +1 soma no estoque, -1 subtrai (o ajuste já vem com sinal na quantidade).</note>
      <xloc>48</xloc>
      <yloc>16</yloc>
      <width>900</width>
      <heigth>60</heigth>
      <fontname/>
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Tipos de movimento ERP</from>
      <to>Trim + maiúsculo</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Trim + maiúsculo</from>
      <to>Código padrão</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Código padrão</from>
      <to>Remover duplicados</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remover duplicados</from>
      <to>Descrição</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Descrição</from>
      <to>Origem</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Origem</from>
      <to>Fator de sinal</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Fator de sinal</from>
      <to>Selecionar campos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Selecionar campos</from>
      <to>Carregar dim_tipo_movimento</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Tipos de movimento ERP</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ERP-ORIGEM</connection>
    <sql>SELECT DISTINCT tipo_movimento
FROM erp.movimento_estoque</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Trim + maiúsculo</name>
    <type>StringOperations</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>tipo_movimento</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Código padrão</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>tipo_movimento</field_to_use>
    <target_field>cd_tipo</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>ENTRADA</source_value>
        <target_value>ENTRADA</target_value>
      </field>
      <field>
        <source_value>SAIDA</source_value>
        <target_value>SAIDA</target_value>
      </field>
      <field>
        <source_value>SAÍDA</source_value>
        <target_value>SAIDA</target_value>
      </field>
      <field>
        <source_value>AJUSTE</source_value>
        <target_value>AJUSTE</target_value>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Remover duplicados</name>
    <type>UniqueRowsByHashSet</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <store_values>Y</store_values>
    <reject_duplicate_row>N</reject_duplicate_row>
    <error_description/>
    <fields>
      <field>
        <name>cd_tipo</name>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Descrição</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>cd_tipo</field_to_use>
    <target_field>descricao</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>ENTRADA</source_value>
        <target_value>Entrada de mercadoria</target_value>
      </field>
      <field>
        <source_value>SAIDA</source_value>
        <target_value>Saída de mercadoria</target_value>
      </field>
      <field>
        <source_value>AJUSTE</source_value>
        <target_value>Ajuste de inventário</target_value>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Origem</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>cd_tipo</field_to_use>
    <target_field>origem</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>ENTRADA</source_value>
        <target_value>Compra</target_value>
      </field>
      <field>
        <source_value>SAIDA</source_value>
        <target_value>Venda</target_value>
      </field>
      <field>
        <source_value>AJUSTE</source_value>
        <target_value>Inventário</target_value>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>960</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Fator de sinal</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>cd_tipo</field_to_use>
    <target_field>fator_txt</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>ENTRADA</source_value>
        <target_value>1</target_value>
      </field>
      <field>
        <source_value>SAIDA</source_value>
        <target_value>-1</target_value>
      </field>
      <field>
        <source_value>AJUSTE</source_value>
        <target_value>1</target_value>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>960</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Selecionar campos</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>cd_tipo</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>descricao</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>origem</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>fator_txt</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <meta>
        <name>fator_txt</name>
        <rename>fator_sinal</rename>
        <type>Integer</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type/>
        <conversion_mask/>
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>N</lenient_string_to_number>
        <encoding/>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <roundingType>half_even</roundingType>
      </meta>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Carregar dim_tipo_movimento</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DW-DESTINO</connection>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>dw</schema>
      <table>dim_tipo_movimento</table>
      <key>
        <name>cd_tipo</name>
        <field>cd_tipo</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>cd_tipo</name>
        <rename>cd_tipo</rename>
        <update>N</update>
      </value>
      <value>
        <name>descricao</name>
        <rename>descricao</rename>
        <update>Y</update>
      </value>
      <value>
        <name>origem</name>
        <rename>origem</rename>
        <update>Y</update>
      </value>
      <value>
        <name>fator_sinal</name>
        <rename>fator_sinal</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
