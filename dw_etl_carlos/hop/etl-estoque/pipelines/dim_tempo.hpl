<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_tempo</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Gera o calendário de 2026 e carrega dw.dim_tempo (sk_tempo = AAAAMMDD)</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>Carlos Eduardo Gaffo da Rocha</created_user>
    <created_date>2026/11/09 12:00:00.000</created_date>
    <modified_user>Carlos Eduardo Gaffo da Rocha</modified_user>
    <modified_date>2026/11/09 12:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>dim_tempo: Generate rows (365 linhas a partir de 2026-01-01) + Add sequence + Calculator. sk_tempo = dia + mes*100 + ano*10000 (ex.: 20260315). SCD Tipo 1 via Insert / update.</note>
      <xloc>48</xloc>
      <yloc>16</yloc>
      <width>900</width>
      <heigth>60</heigth>
      <fontname/>
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Gerar 365 dias</from>
      <to>Dia do ano (offset)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Dia do ano (offset)</from>
      <to>Calcular atributos da data</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calcular atributos da data</from>
      <to>Nome do mês</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Nome do mês</from>
      <to>Nome do dia da semana</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Nome do dia da semana</from>
      <to>Fim de semana S/N</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Fim de semana S/N</from>
      <to>Carregar dim_tempo</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Gerar 365 dias</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>data_inicial</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency/>
        <decimal/>
        <group/>
        <nullif>2026-01-01</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>c100</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal/>
        <group/>
        <nullif>100</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>c10000</name>
        <type>Integer</type>
        <format>#</format>
        <currency/>
        <decimal/>
        <group/>
        <nullif>10000</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <limit>365</limit>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Dia do ano (offset)</name>
    <type>Sequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <valuename>dia_offset</valuename>
    <use_database>N</use_database>
    <connection/>
    <schema/>
    <seqname>SEQ_</seqname>
    <use_counter>Y</use_counter>
    <counter_name/>
    <start_at>0</start_at>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Calcular atributos da data</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <failIfNoFile>Y</failIfNoFile>
    <calculation>
      <field_name>data</field_name>
      <calc_type>ADD_DAYS</calc_type>
      <field_a>data_inicial</field_a>
      <field_b>dia_offset</field_b>
      <field_c/>
      <value_type>Date</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>ano</field_name>
      <calc_type>YEAR_OF_DATE</calc_type>
      <field_a>data</field_a>
      <field_b/>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>mes</field_name>
      <calc_type>MONTH_OF_DATE</calc_type>
      <field_a>data</field_a>
      <field_b/>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>dia</field_name>
      <calc_type>DAY_OF_MONTH</calc_type>
      <field_a>data</field_a>
      <field_b/>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>trimestre</field_name>
      <calc_type>QUARTER_OF_DATE</calc_type>
      <field_a>data</field_a>
      <field_b/>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>dia_semana</field_name>
      <calc_type>DAY_OF_WEEK</calc_type>
      <field_a>data</field_a>
      <field_b/>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>dia_mes</field_name>
      <calc_type>COMBINATION_1</calc_type>
      <field_a>dia</field_a>
      <field_b>mes</field_b>
      <field_c>c100</field_c>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>Y</remove>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <calculation>
      <field_name>sk_tempo</field_name>
      <calc_type>COMBINATION_1</calc_type>
      <field_a>dia_mes</field_a>
      <field_b>ano</field_b>
      <field_c>c10000</field_c>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
    </calculation>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Nome do mês</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>mes</field_to_use>
    <target_field>nome_mes</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>1</source_value>
        <target_value>Janeiro</target_value>
      </field>
      <field>
        <source_value>2</source_value>
        <target_value>Fevereiro</target_value>
      </field>
      <field>
        <source_value>3</source_value>
        <target_value>Março</target_value>
      </field>
      <field>
        <source_value>4</source_value>
        <target_value>Abril</target_value>
      </field>
      <field>
        <source_value>5</source_value>
        <target_value>Maio</target_value>
      </field>
      <field>
        <source_value>6</source_value>
        <target_value>Junho</target_value>
      </field>
      <field>
        <source_value>7</source_value>
        <target_value>Julho</target_value>
      </field>
      <field>
        <source_value>8</source_value>
        <target_value>Agosto</target_value>
      </field>
      <field>
        <source_value>9</source_value>
        <target_value>Setembro</target_value>
      </field>
      <field>
        <source_value>10</source_value>
        <target_value>Outubro</target_value>
      </field>
      <field>
        <source_value>11</source_value>
        <target_value>Novembro</target_value>
      </field>
      <field>
        <source_value>12</source_value>
        <target_value>Dezembro</target_value>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Nome do dia da semana</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>dia_semana</field_to_use>
    <target_field>nome_dia_semana</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>1</source_value>
        <target_value>Domingo</target_value>
      </field>
      <field>
        <source_value>2</source_value>
        <target_value>Segunda-feira</target_value>
      </field>
      <field>
        <source_value>3</source_value>
        <target_value>Terça-feira</target_value>
      </field>
      <field>
        <source_value>4</source_value>
        <target_value>Quarta-feira</target_value>
      </field>
      <field>
        <source_value>5</source_value>
        <target_value>Quinta-feira</target_value>
      </field>
      <field>
        <source_value>6</source_value>
        <target_value>Sexta-feira</target_value>
      </field>
      <field>
        <source_value>7</source_value>
        <target_value>Sábado</target_value>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Fim de semana S/N</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>dia_semana</field_to_use>
    <target_field>fim_de_semana</target_field>
    <non_match_default>N</non_match_default>
    <fields>
      <field>
        <source_value>1</source_value>
        <target_value>S</target_value>
      </field>
      <field>
        <source_value>7</source_value>
        <target_value>S</target_value>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>960</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Carregar dim_tempo</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DW-DESTINO</connection>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>dw</schema>
      <table>dim_tempo</table>
      <key>
        <name>sk_tempo</name>
        <field>sk_tempo</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>sk_tempo</name>
        <rename>sk_tempo</rename>
        <update>N</update>
      </value>
      <value>
        <name>data</name>
        <rename>data</rename>
        <update>Y</update>
      </value>
      <value>
        <name>dia</name>
        <rename>dia</rename>
        <update>Y</update>
      </value>
      <value>
        <name>mes</name>
        <rename>mes</rename>
        <update>Y</update>
      </value>
      <value>
        <name>nome_mes</name>
        <rename>nome_mes</rename>
        <update>Y</update>
      </value>
      <value>
        <name>trimestre</name>
        <rename>trimestre</rename>
        <update>Y</update>
      </value>
      <value>
        <name>ano</name>
        <rename>ano</rename>
        <update>Y</update>
      </value>
      <value>
        <name>dia_semana</name>
        <rename>dia_semana</rename>
        <update>Y</update>
      </value>
      <value>
        <name>nome_dia_semana</name>
        <rename>nome_dia_semana</rename>
        <update>Y</update>
      </value>
      <value>
        <name>fim_de_semana</name>
        <rename>fim_de_semana</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>960</xloc>
      <yloc>272</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
