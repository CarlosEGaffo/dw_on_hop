<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>dim_deposito</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Depósito + filial + cidade + estado, com UF e nome do estado padronizados</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>Carlos Eduardo Gaffo da Rocha</created_user>
    <created_date>2026/11/09 12:00:00.000</created_date>
    <modified_user>Carlos Eduardo Gaffo da Rocha</modified_user>
    <modified_date>2026/11/09 12:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>dim_deposito: mesmo tratamento do exemplo de Estado dos slides (Trim + Upper na UF e Value Mapper UF -&gt; nome do estado), aplicado à hierarquia depósito &gt; filial &gt; cidade &gt; estado.</note>
      <xloc>48</xloc>
      <yloc>16</yloc>
      <width>900</width>
      <heigth>60</heigth>
      <fontname/>
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Depósitos ERP</from>
      <to>Padronizar textos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Padronizar textos</from>
      <to>Nome do estado pela UF</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Nome do estado pela UF</from>
      <to>Selecionar campos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Selecionar campos</from>
      <to>Carregar dim_deposito</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Depósitos ERP</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ERP-ORIGEM</connection>
    <sql>SELECT d.id_deposito  AS nk_deposito,
       d.nome         AS nome_deposito,
       d.capacidade_m3,
       f.nome         AS nome_filial,
       f.tipo         AS tipo_filial,
       c.nome         AS cidade,
       e.uf,
       e.regiao
FROM erp.deposito d
JOIN erp.filial f ON f.id_filial = d.id_filial
JOIN erp.cidade c ON c.id_cidade = f.id_cidade
JOIN erp.estado e ON e.id_estado = c.id_estado
ORDER BY d.id_deposito</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <attributes/>
    <GUI>
      <xloc>80</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Padronizar textos</name>
    <type>StringOperations</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>uf</in_stream_name>
        <out_stream_name>uf_padrao</out_stream_name>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>nome_deposito</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>nome_filial</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>tipo_filial</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>cidade</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>regiao</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Nome do estado pela UF</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>uf_padrao</field_to_use>
    <target_field>nome_estado_padrao</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>PR</source_value>
        <target_value>Paraná</target_value>
      </field>
      <field>
        <source_value>SP</source_value>
        <target_value>São Paulo</target_value>
      </field>
      <field>
        <source_value>SC</source_value>
        <target_value>Santa Catarina</target_value>
      </field>
      <field>
        <source_value>MS</source_value>
        <target_value>Mato Grosso do Sul</target_value>
      </field>
      <field>
        <source_value>RS</source_value>
        <target_value>Rio Grande do Sul</target_value>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Selecionar campos</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>nk_deposito</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>nome_deposito</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>capacidade_m3</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>nome_filial</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>tipo_filial</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>cidade</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>uf_padrao</name>
        <rename>uf</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>nome_estado_padrao</name>
        <rename>nome_estado</rename>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>regiao</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Carregar dim_deposito</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>DW-DESTINO</connection>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>dw</schema>
      <table>dim_deposito</table>
      <key>
        <name>nk_deposito</name>
        <field>nk_deposito</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>nk_deposito</name>
        <rename>nk_deposito</rename>
        <update>N</update>
      </value>
      <value>
        <name>nome_deposito</name>
        <rename>nome_deposito</rename>
        <update>Y</update>
      </value>
      <value>
        <name>capacidade_m3</name>
        <rename>capacidade_m3</rename>
        <update>Y</update>
      </value>
      <value>
        <name>nome_filial</name>
        <rename>nome_filial</rename>
        <update>Y</update>
      </value>
      <value>
        <name>tipo_filial</name>
        <rename>tipo_filial</rename>
        <update>Y</update>
      </value>
      <value>
        <name>cidade</name>
        <rename>cidade</rename>
        <update>Y</update>
      </value>
      <value>
        <name>uf</name>
        <rename>uf</rename>
        <update>Y</update>
      </value>
      <value>
        <name>nome_estado</name>
        <rename>nome_estado</rename>
        <update>Y</update>
      </value>
      <value>
        <name>regiao</name>
        <rename>regiao</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
