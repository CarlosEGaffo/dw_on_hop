<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>carga_dw_estoque</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Carga completa do DW de Estoque: dimensões e, por último, a fato</description>
  <extended_description/>
  <workflow_version/>
  <created_user>Carlos Eduardo Gaffo da Rocha</created_user>
  <created_date>2026/11/09 12:00:00.000</created_date>
